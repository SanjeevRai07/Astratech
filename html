            white-space: nowrap;
        }

        .contact a {
            color: #202020;
            text-decoration: none;
        }

        /* ================= SECTION ================= */

        .section {
            margin-top: 14px;
        }

        .section-title {
            color: #142b4d;
            font-size: 14px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            border-bottom: 1px solid #b8c0ca;
            padding-bottom: 4px;
            margin-bottom: 8px;
        }

        /* ================= SUMMARY ================= */

        .summary {
            font-size: 10.5px;
            text-align: justify;
        }

        /* ================= SKILLS ================= */

        .skills {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px 28px;
        }

        .skill-row {
            font-size: 10.2px;
        }

        .skill-row strong {
            color: #142b4d;
        }

        /* ================= PROJECTS ================= */

        .project {
            margin-bottom: 10px;
        }

        .project:last-child {
            margin-bottom: 0;
        }

        .project-header {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            gap: 10px;
        }

        .project-title {
            font-size: 11.5px;
            font-weight: 700;
            color: #142b4d;
        }

        .project-tech {
            font-size: 9px;
            color: #555;
            font-style: italic;
            text-align: right;
        }

        .project ul {
            margin: 4px 0 0 18px;
        }

        .project li {
            font-size: 10px;
            margin-bottom: 2px;
            padding-left: 2px;
        }

        /* ================= EDUCATION ================= */

        .education-item {
            margin-bottom: 8px;
        }

        .education-main {
            display: flex;
            justify-content: space-between;
            gap: 15px;
        }

        .degree {
            font-size: 10.8px;
            font-weight: 700;
            color: #142b4d;
        }

        .year {
            font-size: 10px;
            white-space: nowrap;
        }

        .institution {
            font-size: 10px;
            color: #333;
        }

        /* ================= CERTIFICATION ================= */

        .certification {
            display: flex;
            justify-content: space-between;
            font-size: 10.5px;
        }

        /* ================= TWO COLUMN LOWER AREA ================= */

        .bottom-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 28px;
        }

        .small-list {
            margin-left: 17px;
        }

        .small-list li {
            font-size: 10px;
            margin-bottom: 3px;
        }

        /* ================= PRINT ================= */

        @media print {

            @page {
                size: A4;
                margin: 0;
            }

            body {
                background: white;
            }

            .resume {
                width: 210mm;
